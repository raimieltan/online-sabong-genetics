{
  "name": "rooster-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./scripts/test-ts-loader.mjs --test --test-concurrency=1 lib/__tests__/*.test.ts",
    "db:up": "docker compose up -d",
    "seed:god": "node --import ./scripts/test-ts-loader.mjs scripts/seed-god-chickens.ts",
    "seed:monochrome": "node --import ./scripts/test-ts-loader.mjs scripts/seed-monochrome-pairs.ts",
    "seed:redblack": "node --import ./scripts/test-ts-loader.mjs scripts/seed-deep-red-black-roster.ts",
    "seed:strategy": "node --import ./scripts/test-ts-loader.mjs scripts/seed-strategy-fighter-roster.ts",
    "backfill:colors": "node --import ./scripts/test-ts-loader.mjs scripts/backfill-color-jitter.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/rapier": "^2.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "yarn@1.22.22"
}
